# .env dosyasının örneği (gerçek anahtar YOK, repoya girebilir)
# Kopyala: cp .env.example .env  ve kendi TESTNET anahtarını yaz
PRIVATE_KEY=0x...

# RacePool deploy'u için: sunucunun imza ADRESİ (server/.env'deki RESULT_SIGNER_KEY'in adresi).
# Anahtarın kendisi buraya değil, sadece server/.env'e yazılır
RESULT_SIGNER=0x...
# %5 payın gideceği adres (boş bırakılırsa deploy eden adres)
# TREASURY=0x...
