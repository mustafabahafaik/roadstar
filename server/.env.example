# Sunucu ayarları. Kopyala: cp .env.example .env  (server/ içinde). .env repoya GİRMEZ (.gitignore)

# Sıralamayı imzalayan anahtar. SADECE imza atar, para tutmasına gerek yok.
# ⚠️ Bunu bilen herkes sahte sonuç imzalayıp havuzu boşaltabilir: asla paylaşma, repoya koyma.
# Yeni anahtar: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
RESULT_SIGNER_KEY=0x...

# RacePool kontratının adresi (deploy edince). Boşsa sunucu sadece ücretsiz yarış açar
POOL_ADDRESS=

# Zincir RPC adresi (varsayılan: Monad testnet)
# RPC_URL=https://testnet-rpc.monad.xyz

# PORT=3001
# İnternete yüklerken oyunun adresi (CORS): CLIENT_ORIGIN=https://oyunun-adresi

# Bot cüzdanları (boş koltukları dolduran botlar giriş ücretini bunlardan öder).
# Üretmek için kökte: node scripts/make-bots.js  (buraya kendisi yazar, sonra faucet'ten yükle)
# BOT_KEYS=0x...,0x...
# Bot bakiyesi bunun altına düşünce sunucu konsolunda uyarı (MON). Varsayılan 0.3 ≈ 3 ücretli yarış
# (0.05 giriş + gaz). ENTRY_FEE'yi (src/chain.js) değiştirirsen bunu da değiştir
# BOT_LOW_BALANCE=0.3
