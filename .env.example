# Oyunun ayarları (Vite). Bu dosyayı ".env" adıyla kopyala ve değiştir.
# Vite yalnızca VITE_ ile başlayan değişkenleri oyuna verir; buraya GİZLİ bilgi koyma (tarayıcıda görünür).

# Çok oyunculu sunucunun adresi (server/index.js). İnternete yükleyince buraya o adresi yaz
VITE_SERVER_URL=http://localhost:3001
