# Oyunun ayarları (Vite). Yerelde bu dosyayı ".env" adıyla kopyala; internette (Vercel) aynı adlarla
# ortam değişkeni olarak gir. Vite yalnızca VITE_ ile başlayanları oyuna verir ve DERLEME anında koda gömer:
# değiştirince yeniden derle / yeniden deploy et. Buraya GİZLİ bilgi koyma (tarayıcıda herkes görür).

# Çok oyunculu sunucunun adresi (Render'daki adres). Boşsa: sayfayı sunan bilgisayarın 3001 portu
# VITE_SERVER_URL=https://roadstar-server.onrender.com

# Kontrat adresleri (Monad testnet). Boşsa src/chain.js'teki varsayılanlar
# VITE_RACE_ADDRESS=0x7cBF7eAbB758CD0DBEAd1DFa9Adc8FA9A6e6f434
# VITE_POOL_ADDRESS=0x...
# VITE_GARAGE_ADDRESS=0x...
# İzleyici bahsi (BetPool): server/.env BET_POOL_ADDRESS ile aynı
# VITE_BET_ADDRESS=0x...
